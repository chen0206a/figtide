{
  "name": "@figtide/mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "FigTide local MCP bridge",
  "license": "MIT",
  "type": "module",
  "main": "dist/figtide-mcp.cjs",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node18 --outfile=dist/figtide-mcp.cjs --banner:js=\"#!/usr/bin/env node\"",
    "check": "tsc --noEmit",
    "test": "vitest run test/unit",
    "test:integration": "vitest run test/integration.test.ts --testTimeout 120000",
    "start": "node dist/figtide-mcp.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=18"
  }
}
