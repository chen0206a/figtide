@@ -0,0 +1,218 @@
+import { describe, it, expect } from "vitest";
+import type { Dataset } from "../lib/api";
+import {
+  defaults,
+  defaultClassification,
+  defaultEvaluation,
+  makeSeries,
+  type Config,
+} from "./model";
+import { buildPlot } from "./plot";
+import { groupEncoding, integerAxisStep } from "./encoding";
+
+const grouped: Dataset = {
+  id: 1,
+  dataset_id: 1,
+  version: 1,
+  filename: "synthetic-grouped.csv",
+  sha256: "demo",
+  row_count: 6,
+  warnings: [],
+  fields: [
+    { name: "epoch", type: "number", missing: 0 },
+    { name: "model", type: "string", missing: 0 },
+    { name: "accuracy", type: "number", missing: 0 },
+    { name: "loss", type: "number", missing: 0 },
+  ],
+  rows: [
+    { epoch: 1, model: "Baseline", accuracy: 0.65, loss: 0.9 },
+    { epoch: 2, model: "Baseline", accuracy: 0.8, loss: 0.6 },
+    { epoch: 3, model: "Baseline", accuracy: 0.86, loss: 0.5 },
+    { epoch: 1, model: "Method A", accuracy: 0.72, loss: 0.8 },
+    { epoch: 2, model: "Method A", accuracy: 0.86, loss: 0.5 },
+    { epoch: 3, model: "Method A", accuracy: 0.92, loss: 0.4 },
+  ],
+};
+function groupedLine(): Config {
+  const c = defaults(grouped);
+  return {
+    ...c,
+    type: "line",
+    x: "epoch",
+    group: "model",
+    series: [{ ...makeSeries("accuracy"), name: "Accuracy · mean ± SEM" }],
+  };
+}
+const legendTraces = (traces: any[]) =>
+  traces.filter((t) => t.showlegend !== false);
+
+describe("grouped series encoding", () => {
+  it("gives every group of a single series its own color", () => {
+    const p = buildPlot(groupedLine(), grouped);
+    const [a, b] = legendTraces(p.traces);
+    expect(a.line.color).not.toBe(b.line.color);
+    expect(a.marker.color).toBe(a.line.color);
+    expect(b.marker.color).toBe(b.line.color);
+  });
+  it("keeps the user's series color for the first group", () => {
+    const c = groupedLine();
+    c.series[0].color = "#123456";
+    const [first] = legendTraces(buildPlot(c, grouped).traces);
+    expect(first.line.color).toBe("#123456");
+  });
+  it("names grouped traces by group and moves the series name to the legend title", () => {
+    const p = buildPlot(groupedLine(), grouped);
+    expect(legendTraces(p.traces).map((t) => t.name)).toEqual([
+      "Baseline",
+      "Method A",
+    ]);
+    expect(p.layout.legend.title.text).toBe("Accuracy · mean ± SEM");
+  });
+  it("uses color for group and dash for series when several series are grouped", () => {
+    const c = groupedLine();
+    c.series = [makeSeries("accuracy"), makeSeries("loss", 1)];
+    const traces = legendTraces(buildPlot(c, grouped).traces);
+    expect(traces.map((t) => t.name)).toEqual([
+      "accuracy · Baseline",
+      "accuracy · Method A",
+      "loss · Baseline",
+      "loss · Method A",
+    ]);
+    expect(traces[0].line.color).toBe(traces[2].line.color);
+    expect(traces[0].line.color).not.toBe(traces[1].line.color);
+    expect(traces[0].line.dash).not.toBe(traces[2].line.dash);
+    expect(buildPlot(c, grouped).layout.legend.title).toBeUndefined();
+  });
+  it("leaves ungrouped series untouched", () => {
+    const c = groupedLine();
+    c.group = "";
+    const s = c.series[0];
+    expect(groupEncoding(c, s, 0, 1)).toEqual({
+      color: s.color,
+      dash: s.dash,
+      symbol: s.symbol,
+    });
+    const p = buildPlot(c, grouped);
+    expect(p.traces[0].name).toBe("Accuracy · mean ± SEM");
+    expect(p.layout.legend.title).toBeUndefined();
+  });
+});
+
+describe("integer x axis ticks", () => {
+  it("steps by one on short integer axes", () => {
+    expect(integerAxisStep([1, 2, 3])).toBe(1);
+    expect(buildPlot(groupedLine(), grouped).layout.xaxis.dtick).toBe(1);
+  });
+  it("leaves long, fractional or user-set axes to Plotly", () => {
+    expect(integerAxisStep([0, 60])).toBeUndefined();
+    expect(integerAxisStep([0.5, 1, 1.5])).toBeUndefined();
+    expect(integerAxisStep(["a", "b"])).toBeUndefined();
+    const c = groupedLine();
+    c.axes.x.dtick = "0.5";
+    expect(buildPlot(c, grouped).layout.xaxis.dtick).toBe(0.5);
+  });
+});
+
+describe("confusion matrix layout", () => {
+  const rows = [
+    ["A", "A"],
+    ["A", "B"],
+    ["B", "B"],
+    ["B", "B"],
+    ["C", "C"],
+    ["C", "A"],
+  ].map(([truth, a], i) => ({ id: i + 1, truth, a }));
+  const data: Dataset = {
+    id: 1,
+    dataset_id: 1,
+    version: 1,
+    filename: "synthetic-classes.csv",
+    sha256: "demo",
+    row_count: rows.length,
+    warnings: [],
+    fields: [
+      { name: "id", type: "number", missing: 0 },
+      { name: "truth", type: "string", missing: 0 },
+      { name: "a", type: "string", missing: 0 },
+    ],
+    rows,
+  };
+  function confusion(): Config {
+    return {
+      ...defaults(data),
+      type: "confusion",
+      series: [{ ...makeSeries("id"), name: "Model A", prediction: "a" }],
+      classification: {
+        ...defaultClassification,
+        label: "truth",
+        classes: ["A", "B", "C"],
+      },
+    };
+  }
+  it("anchors the subtitle above the cells and reserves top margin for it", () => {
+    const c = confusion();
+    const p = buildPlot(c, data);
+    const subtitle = p.layout.annotations.find((a: any) =>
+      String(a.text).includes("n=6"),
+    );
+    expect(subtitle).toMatchObject({ yref: "paper", y: 1, yanchor: "bottom" });
+    const plain = buildPlot({ ...c, type: "line", x: "id" }, data);
+    expect(p.layout.margin.t).toBeGreaterThan(plain.layout.margin.t);
+  });
+  it("uses integer colorbar ticks for counts and percentages for shares", () => {
+    const c = confusion();
+    const counts = buildPlot(c, data).traces[0].marker.colorbar;
+    expect(counts.tickformat).toBe("d");
+    expect(Number.isInteger(counts.dtick)).toBe(true);
+    expect(counts.title.text).toBe("Count");
+    c.classification!.normalization = "true";
+    expect(buildPlot(c, data).traces[0].marker.colorbar.tickformat).toBe(
+      ".0%",
+    );
+  });
+});
+
+describe("evaluation legend metric", () => {
+  const data: Dataset = {
+    id: 1,
+    dataset_id: 1,
+    version: 1,
+    filename: "synthetic-evaluation.csv",
+    sha256: "demo",
+    row_count: 4,
+    warnings: [],
+    fields: [
+      { name: "label", type: "string", missing: 0 },
+      { name: "score", type: "number", missing: 0 },
+    ],
+    rows: [0.1, 0.4, 0.35, 0.8].map((score, i) => ({
+      label: i < 2 ? "neg" : "pos",
+      score,
+    })),
+  };
+  function roc(legendMetric?: boolean): Config {
+    const evaluation = { ...defaultEvaluation, label: "label", positive: "pos" };
+    if (legendMetric === undefined) delete evaluation.legendMetric;
+    else evaluation.legendMetric = legendMetric;
+    return {
+      ...defaults(data),
+      type: "roc",
+      series: [{ ...makeSeries("score"), name: "Model A" }],
+      evaluation,
+    };
+  }
+  it("appends AUC for new charts and AP for PR curves", () => {
+    expect(buildPlot(roc(true), data).traces[0].name).toBe(
+      "Model A (AUC = 0.750)",
+    );
+    const pr = roc(true);
+    pr.type = "pr";
+    expect(buildPlot(pr, data).traces[0].name).toMatch(
+      /^Model A \(AP = 0\.83\d\)$/,
+    );
+  });
+  it("keeps charts saved without the option unchanged", () => {
+    expect(buildPlot(roc(undefined), data).traces[0].name).toBe("Model A");
+    expect(buildPlot(roc(false), data).traces[0].name).toBe("Model A");
+  });
+});
diff --git a/frontend/src/editor/encoding.ts b/frontend/src/editor/encoding.ts
new file mode 100644
index 0000000..eb113d8
--- /dev/null
+++ b/frontend/src/editor/encoding.ts
@@ -0,0 +1,97 @@
+import type { Config, Series } from "./model";
+import { palettes } from "./model";
+import { stylePresets } from "./stylePresets";
+
+const DASHES = ["solid", "dash", "dot", "dashdot"];
+const SYMBOLS = ["circle", "square", "diamond", "triangle-up"];
+
+export const visibleSeries = (c: Config) => c.series.filter((s) => s.visible);
+
+/** Palette of the active style preset; falls back to the legacy model palettes. */
+export function presetColors(c: Config): readonly string[] {
+  return (
+    stylePresets.find((p) => p.key === c.style.preset)?.colors ||
+    palettes[c.style.preset] ||
+    palettes["Clean Academic"]
+  );
+}
+
+/**
+ * Visual encoding for one category group inside one series.
+ *
+ * - No grouping (or a single group): the series keeps its own color/dash/symbol.
+ * - One visible series split by groups: group 0 keeps the series color, later
+ *   groups continue through the preset palette so every group is distinct.
+ * - Several visible series × groups: color identifies the group, dash/symbol
+ *   identify the series.
+ *
+ * Series identity for selection stays in `customdata`; this only changes paint.
+ */
+export function groupEncoding(
+  c: Config,
+  s: Series,
+  groupIndex: number,
+  groupCount: number,
+): { color: string; dash: string; symbol: string } {
+  if (groupCount <= 1) return { color: s.color, dash: s.dash, symbol: s.symbol };
+  const colors = presetColors(c);
+  const visible = visibleSeries(c);
+  if (visible.length <= 1) {
+    if (groupIndex === 0) return { color: s.color, dash: s.dash, symbol: s.symbol };
+    const own = colors.findIndex((v) => v.toLowerCase() === s.color.toLowerCase());
+    // Skip the series' own color so group 1+ never repeats group 0.
+    const pool = own >= 0 ? colors.filter((_, i) => i !== own) : colors;
+    const start = own >= 0 ? own : 0;
+    return {
+      color: pool[(start + groupIndex - 1) % pool.length],
+      dash: s.dash,
+      symbol: s.symbol,
+    };
+  }
+  const seriesIndex = Math.max(
+    0,
+    visible.findIndex((v) => v.id === s.id),
+  );
+  return {
+    color: colors[groupIndex % colors.length],
+    dash: DASHES[seriesIndex % DASHES.length],
+    symbol: SYMBOLS[seriesIndex % SYMBOLS.length],
+  };
+}
+
+/**
+ * Legend label for a grouped trace. With one visible series the group value is
+ * enough (the series name becomes the legend title); otherwise keep both.
+ */
+export function groupTraceName(
+  c: Config,
+  s: Series,
+  group: unknown,
+  missingLabel = "缺失分组",
+): string {
+  if (!c.group) return s.name;
+  const label = String(group ?? missingLabel);
+  return visibleSeries(c).length === 1 ? label : `${s.name} · ${label}`;
+}
+
+/** Legend title used when a single series is split into groups. */
+export function groupLegendTitle(c: Config): string {
+  const visible = visibleSeries(c);
+  return c.group && visible.length === 1 ? visible[0].name : "";
+}
+
+/**
+ * Plotly picks fractional steps (1, 1.5, 2 …) for short integer axes such as
+ * epochs or seeds. Use a step of 1 when every finite value is an integer and
+ * the span is short; leave everything else to Plotly's automatic ticks.
+ */
+export function integerAxisStep(values: unknown[]): number | undefined {
+  const numbers = values.filter(
+    (v): v is number => typeof v === "number" && Number.isFinite(v),
+  );
+  if (numbers.length < 2 || numbers.length !== values.filter((v) => v != null).length)
+    return undefined;
+  if (!numbers.every((v) => Number.isInteger(v))) return undefined;
+  const span = Math.max(...numbers) - Math.min(...numbers);
+  return span > 0 && span <= 10 ? 1 : undefined;
+}
