exports[`isometric renderer > has stable parseable finished-size SVG for mechanism 1`] = `
"<svg xmlns="http://www.w3.org/2000/svg" width="180mm" height="110mm" viewBox="0 0 180 110" role="img" aria-label="机制图" font-family="Inter, Arial, sans-serif"><title>Mechanism diagram</title><defs>
    <marker id="dg1773555946-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto-start-reverse" markerUnits="strokeWidth"><path d="M1 1 L7 4 L1 7 Z" fill="#17212B" stroke="#17212B" stroke-width="1"/></marker>
    <marker id="dg1773555946-inhibit" viewBox="0 0 8 10" refX="6" refY="5" markerWidth="7" markerHeight="9" orient="auto" markerUnits="strokeWidth"><path d="M6 1 L6 9" fill="none" stroke="#D55E00" stroke-width="1.5"/></marker>
